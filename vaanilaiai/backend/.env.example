# VaanilaiAI Backend Environment Configuration

# Server
DEBUG=True
HOST=0.0.0.0
PORT=8000
RELOAD=True

# Database Configuration (PostgreSQL in production, SQLite by default for development)
DATABASE_URL=sqlite+aiosqlite:///./vaanilai.db
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/vaanilai_db

# Gemini AI API Key (Optional for basic deterministic fallback; required for full LLM generative reasoning)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Cache TTL (seconds)
CACHE_TTL_WEATHER=900
CACHE_TTL_FORECAST=3600
CACHE_TTL_ALERTS=600

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-key
