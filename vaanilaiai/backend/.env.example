# ==============================================================================
# VaanilaiAI (WeatherGPT) Backend Environment Variables
# ==============================================================================

# Project & Server Environment
PROJECT_NAME="VaanilaiAI (WeatherGPT)"
VERSION="1.0.0"
DEBUG=False
PORT=8000

# Security & Secrets
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""

# Allowed CORS Origins (comma-separated, no trailing slashes)
# Example for production: "https://vaanilai.ai,https://vaanilaiai.web.app"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:8080,http://127.0.0.1:8000,http://127.0.0.1:3000"

# Database Connections
# Development (default): sqlite+aiosqlite:///./vaanilai.db
# Production (Render/Postgres): postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL="sqlite+aiosqlite:///./vaanilai.db"

# Optional Redis Cache URL
# Example: redis://default:password@redis-host:6379/0
REDIS_URL=""

# Google Gemini API Keys (comma-separated for automated failover pool)
GEMINI_API_KEY=""
GEMINI_API_KEYS=""
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"

# Firebase Project Configuration
FIREBASE_PROJECT_ID="vaanilaiai"

# Cache TTL Configurations (seconds)
CACHE_TTL_WEATHER=900
CACHE_TTL_FORECAST=3600
CACHE_TTL_ALERTS=600
CACHE_TTL_GEOCODING=86400

# Supported Languages
SUPPORTED_LANGUAGES="en,ta,hi"
DEFAULT_LANGUAGE="en"
